PLATFORMS: list[Platform] = [{% if include_sensor_platform %}Platform.SENSOR{% endif %}]


@dataclass
class RuntimeData:
    """Runtime data for a {{ integration_name }} config entry."""

    title: str


type {{ config_entry_type }} = ConfigEntry[RuntimeData]


async def async_setup_entry(
    hass: HomeAssistant,
    entry: {{ config_entry_type }},
) -> bool:
    """Set up {{ integration_name }} from a config entry."""
    entry.runtime_data = RuntimeData(title=entry.title)

    await hass.config_entries.async_forward_entry_setups(entry, PLATFORMS)

    return True


async def async_unload_entry(
    hass: HomeAssistant,
    entry: {{ config_entry_type }},
) -> bool:
    """Unload a config entry."""
    return await hass.config_entries.async_unload_platforms(entry, PLATFORMS)
